# Copy to .env and fill in. Only EDGE_BASE_URL and ANTHROPIC_API_KEY are required;
# each block you add switches on more checks and more agent tools.
EDGE_BASE_URL=https://weather.vilnico.com
ANTHROPIC_API_KEY=
# Only needed if your key is not scoped to a workspace (console: Settings > Workspaces)
ANTHROPIC_WORKSPACE_ID=
AGENT_MODEL=claude-sonnet-5-5
MAX_DATA_AGE_MIN=90

# Origin (terraform -chdir=infra/01-origin output -raw container_url / read_sas)
ORIGIN_CONTAINER_URL=
ORIGIN_READ_SAS=

# Databricks (host + token, or leave token empty and use `databricks auth login`)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_JOB_ID=
DATABRICKS_WAREHOUSE_ID=
WEATHER_CATALOG=main
WEATHER_SCHEMA=weather

# Cloudflare API token scoped to: Account Analytics Read, Zone Analytics Read, Zone Cache Purge
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
WORKER_NAME=weather-edge

# Optional
SLACK_WEBHOOK_URL=
